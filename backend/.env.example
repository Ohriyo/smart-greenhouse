# Copy to .env and adjust.

# HTTP + Socket.IO port. Open it in Windows Firewall (see docs/setup-mosquitto.md).
PORT=4000

# Mosquitto runs on this laptop, so the backend can use localhost.
# (The ESP32 and phone use the laptop's LAN IP instead.)
MQTT_URL=mqtt://localhost:1883

# SQLite file, relative to the backend/ folder.
DATABASE_URL=file:./dev.db

# Offline detection: MQTT Last Will, or 3 missed telemetry intervals (the device
# reports `intervalSec`). This is the fallback timeout for devices that don't.
OFFLINE_AFTER_SEC=90

# Minimum minutes between two alerts for the same metric (unless severity rises).
ALERT_COOLDOWN_MIN=15
