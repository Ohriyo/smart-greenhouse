# Copy to .env.test (git-ignored) for the database tests (npm test).
# An EMPTY local PostgreSQL database whose name contains "test": the tests
# delete every row in it. Create it once, in PowerShell:
#   psql -U postgres -h localhost -c "CREATE DATABASE greenhouse_test;"
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F, # → %23, % → %25).
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/greenhouse_test
