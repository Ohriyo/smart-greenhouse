{
  "name": "smart-greenhouse-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Greenhouse backend: MQTT ingest, REST API, Socket.IO",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "socket:watch": "tsx scripts/watch-socket.ts",
    "sms:check": "tsx scripts/sms-check.ts",
    "sim": "tsx scripts/simulator.ts",
    "seed:history": "tsx scripts/seed-history.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "expo-server-sdk": "^8.0.0",
    "express": "^5.3.0",
    "mqtt": "^5.16.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
