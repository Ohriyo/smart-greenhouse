# Copy to .env and put your laptop's LAN IP (run `ipconfig`, use the Wi-Fi "IPv4 Address").
# The backend also prints it at startup: "LAN: http://192.168.x.x:4000".
# EXPO_PUBLIC_* values are embedded into the app bundle; restart `npx expo start` after changing.
# Later the app's Settings screen can override this at runtime.
EXPO_PUBLIC_API_URL=http://<laptop-LAN-IP>:4000
