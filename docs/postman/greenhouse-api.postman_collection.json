{
  "info": {
    "name": "ETanim greenhouse API",
    "description": "The backend REST API (docs/api-contract.md). Set baseUrl (https://<your-service>.onrender.com or http://localhost:4000). For folders 2 and 3 also set deviceKey (= DEVICE_API_KEY) and adminKey (= ADMIN_API_KEY) as CURRENT values only, so they are never saved or shared. Folders: 1 read-only, 2 error handling, 3 changes things. Run the collection (Runner) for a pass/fail table.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Read-only (safe)",
      "item": [
        {
          "name": "Render health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('database is ok', function () { pm.expect(json.db).to.eql('ok'); });",
                  "pm.test('MQTT broker connected (EMQX)', function () { pm.expect(json.mqtt).to.eql('connected'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "What Render polls, and the ESP32 pings every 10 min (keeps the free service awake): always 200 while the process runs; db = ok | error; mqtt = connected | disconnected | off (the backend's EMQX connection). The first call after 15 idle minutes takes about a minute (cold start)."
          }
        },
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('database is ok', function () { pm.expect(json.db).to.eql('ok'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "The app's connection check: 200 with db ok, 503 when the database is down."
          }
        },
        {
          "name": "Latest reading (the evidence request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('has device and reading', function () { pm.expect(json).to.have.property('reading'); pm.expect(json).to.have.property('device'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/readings/latest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "readings",
                "latest"
              ]
            },
            "description": "Newest reading of the greenhouse; both null before the first reading."
          }
        },
        {
          "name": "Readings, last hour (time-ordered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('oldest first', function () { const t = json.points.map(p => Date.parse(p.ts)); pm.expect(t).to.eql([...t].sort((a, b) => a - b)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/readings?range=1h",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "readings"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "1h"
                }
              ]
            },
            "description": "range = 1h | 24h | 7d | 30d. Bucket averages, oldest first."
          }
        },
        {
          "name": "Stats, last 24 h",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('has stats per sensor', function () { pm.expect(json.stats).to.have.all.keys('airTemp', 'humidity', 'soilMoisture', 'lux'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stats?range=24h",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stats"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "24h"
                }
              ]
            },
            "description": "Min / max / average per sensor."
          }
        },
        {
          "name": "Thresholds",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/thresholds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "thresholds"
              ]
            },
            "description": "Alert limits (404 before the first reading)."
          }
        },
        {
          "name": "Devices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices"
              ]
            },
            "description": "All devices, sorted by id."
          }
        },
        {
          "name": "Device latest",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/latest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices",
                "{{deviceId}}",
                "latest"
              ]
            },
            "description": "Device + newest reading."
          }
        },
        {
          "name": "Last 30 minutes of readings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/recent?minutes=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices",
                "{{deviceId}}",
                "recent"
              ],
              "query": [
                {
                  "key": "minutes",
                  "value": "30"
                }
              ]
            },
            "description": "Raw readings for live charts, oldest first."
          }
        },
        {
          "name": "History: air temperature, 24 h",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/history?metric=airTemp&range=24h",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices",
                "{{deviceId}}",
                "history"
              ],
              "query": [
                {
                  "key": "metric",
                  "value": "airTemp"
                },
                {
                  "key": "range",
                  "value": "24h"
                }
              ]
            },
            "description": "avg/min/max per bucket (about 200 points)."
          }
        },
        {
          "name": "Heatmap: temperature by hour, 7 days",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/heatmap?metric=airTemp&days=7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices",
                "{{deviceId}}",
                "heatmap"
              ],
              "query": [
                {
                  "key": "metric",
                  "value": "airTemp"
                },
                {
                  "key": "days",
                  "value": "7"
                }
              ]
            },
            "description": "Hourly averages per Asia/Manila day."
          }
        },
        {
          "name": "Alerts (newest 10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('items carry their SMS status', function () { json.items.forEach(a => pm.expect(a).to.have.property('sms')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alerts?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Newest first; each alert has its SMS status (sms: null when none)."
          }
        },
        {
          "name": "Push notification settings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notifications",
                "settings"
              ]
            },
            "description": "Push preferences (stored on the backend)."
          }
        },
        {
          "name": "SMS status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('numbers are masked', function () { json.recipients.forEach(n => pm.expect(n).to.include('•')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sms/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sms",
                "status"
              ]
            },
            "description": "Read-only SMS setup (dry run, masked numbers, limits) and the 10 newest attempts."
          }
        }
      ]
    },
    {
      "name": "2. Error handling (safe)",
      "item": [
        {
          "name": "Unknown device is a 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/devices/no-such-device/latest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices",
                "no-such-device",
                "latest"
              ]
            },
            "description": "JSON error body, no stack trace."
          }
        },
        {
          "name": "Invalid range is a 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "const json = pm.response.json();",
                  "pm.test('VALIDATION_ERROR', function () { pm.expect(json.error.code).to.eql('VALIDATION_ERROR'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/readings?range=forever",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "readings"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "forever"
                }
              ]
            },
            "description": "Bad query values are rejected."
          }
        },
        {
          "name": "Unknown route is a 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/nothing-here",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "nothing-here"
              ]
            },
            "description": "JSON 404."
          }
        },
        {
          "name": "Reading without the device key is a 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "readings"
              ]
            },
            "description": "X-Device-Key is required; nothing is stored.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"temperature\": 27.4,\n  \"humidity\": 61.2,\n  \"soilMoisture\": 43,\n  \"lux\": 812.5,\n  \"intervalSec\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Out-of-range reading is a 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "const json = pm.response.json();",
                  "pm.test('names the field', function () { pm.expect(json.error.details[0].path).to.eql('humidity'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-Key",
                "value": "{{deviceKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "readings"
              ]
            },
            "description": "humidity 160 % is rejected; nothing is stored. Needs the deviceKey variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"temperature\": 27.4,\n  \"humidity\": 160,\n  \"soilMoisture\": 43,\n  \"lux\": 812.5,\n  \"intervalSec\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Test SMS without the admin key is a 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alerts/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts",
                "test"
              ]
            },
            "description": "X-Admin-Key is required."
          }
        }
      ]
    },
    {
      "name": "3. Changes things: run on purpose",
      "item": [
        {
          "name": "Post a reading like the ESP32",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('stored', function () { pm.expect(json.reading.id).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-Key",
                "value": "{{deviceKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "readings"
              ]
            },
            "description": "Stores a reading (needs the deviceKey variable = DEVICE_API_KEY). Alert rules and SMS run afterwards.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"temperature\": 27.4,\n  \"humidity\": 61.2,\n  \"soilMoisture\": 43,\n  \"lux\": 812.5,\n  \"intervalSec\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send test SMS (REAL text when SMS_DRY_RUN=false!)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Answered (200), or 409 without numbers', function () { pm.expect([200, 409]).to.include(pm.response.code); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/alerts/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts",
                "test"
              ]
            },
            "description": "Needs the adminKey variable (= ADMIN_API_KEY). With SMS_DRY_RUN=true nothing is sent (status dry_run); otherwise this SENDS a real SMS to every ALERT_PHONE_NUMBERS entry and costs credit."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "deviceId",
      "value": "gh-01"
    },
    {
      "key": "deviceKey",
      "value": ""
    },
    {
      "key": "adminKey",
      "value": ""
    }
  ]
}
