# Copy to .env (local development) and fill in. On Render, set the same names in
# the service's Environment tab instead (docs: README "Deploy").
# Never commit .env: it holds secrets.

# development | production (production = JSON logs) | test
NODE_ENV=development

# HTTP + Socket.IO port. Render sets PORT itself.
PORT=4000

# PostgreSQL. Production: the Neon connection string (TLS is enforced for any
# non-local host). Local: e.g. postgresql://postgres:<password>@localhost:5432/greenhouse
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
# Optional: Neon's DIRECT (non-pooled) string, used only by `prisma migrate`.
# Leave unset if DATABASE_URL is already a direct connection.
# DIRECT_URL=

# Shared secret the ESP32 sends as the X-Device-Key header (min 16 characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEVICE_API_KEY=change-me-to-a-long-random-string

# MQTT broker (docs/setup-emqx.md): the ESP32 publishes its readings here; the
# backend subscribes. EMQX Serverless: mqtts://<address from Overview>:8883.
# Empty = MQTT off (readings only over HTTPS POST /api/readings).
MQTT_URL=
# The BACKEND's login (EMQX → Access Control → Authentication). Secret password.
# The ESP32 has its own login (firmware secrets.h).
MQTT_USERNAME=
MQTT_PASSWORD=

# Browser origins allowed to call the API (the Vercel web app), comma-separated,
# no trailing slash. localhost is always allowed for development.
CORS_ORIGIN=https://your-app.vercel.app

# Device used when a reading or query names none (single greenhouse).
DEFAULT_DEVICE_ID=gh-01

# debug | info | warn | error
LOG_LEVEL=info

# Offline detection: 3 missed reading intervals (the device reports `intervalSec`).
# This is the fallback timeout for devices that don't.
OFFLINE_AFTER_SEC=90

# No repeat SMS for the same sensor + condition (e.g. "air temp HIGH") within this
# many minutes. Also the minimum gap between two in-app alerts of one sensor.
ALERT_COOLDOWN_MINUTES=30

# Raw readings older than this many days are deleted daily (30-day history needs 30).
READINGS_RETENTION_DAYS=30

# Push notifications via Expo Push Service (needs internet). "false" = don't send.
PUSH_ENABLED=true
# Only if you turn on "Enhanced push security" in the Expo project (docs/setup-push.md).
# EXPO_ACCESS_TOKEN=

# Secret for admin-only endpoints: send it as X-Admin-Key to POST /api/alerts/test
# (one real test SMS). Required when NODE_ENV=production. Min 16 characters.
ADMIN_API_KEY=change-me-to-another-long-random-string

# ---- SMS alerts (docs/setup-sms.md) ----
# true = every SMS is recorded and logged as "dry_run"; the provider is never
# called. Set to false for real SMS (needs the provider's API key below).
SMS_DRY_RUN=true
# Who sends the SMS: textbee (an Android phone with the textbee app sends from its
# own SIM; free plan 50/day, 300/month) or semaphore (paid PH SMS service).
SMS_PROVIDER=textbee
# Who gets the SMS: Philippine mobile numbers, comma-separated, e.g.
# 09171234567,+639181234567 (normalized to 09XXXXXXXXX). Empty = no SMS at all.
ALERT_PHONE_NUMBERS=
# textbee (textbee.dev): API key from the dashboard (shown once). Secret: only
# here / in Render, never in the app.
# TEXTBEE_API_KEY=
# The phone's Device ID (textbee app "You're all set!" screen or the dashboard).
# Empty = textbee's default phone.
# TEXTBEE_DEVICE_ID=
# Dual-SIM phone: 0 = SIM 1, 1 = SIM 2. Empty = the phone's default SIM.
# TEXTBEE_SIM_SLOT=
# Semaphore (only with SMS_PROVIDER=semaphore): API key. Secret.
# SEMAPHORE_API_KEY=
# Registered sender name (max 11 characters); leave out to use your account's default.
# SEMAPHORE_SENDER_NAME=
# Safety limit: real alert SMS per rolling 24 hours (test SMS are not counted).
SMS_DAILY_CAP=10
# Text "greenhouse offline" after this many minutes without readings.
SMS_OFFLINE_AFTER_MINUTES=10

# Dev-only "Presentation tools" in the app (simulate a heat wave / dry soil on the
# simulator). Leave it false except when demonstrating.
DEV_TOOLS=false
