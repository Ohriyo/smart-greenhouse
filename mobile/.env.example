# Copy to .env (git-ignored) for local development. The backend's base URL, no trailing slash.
# EXPO_PUBLIC_* values are built into the app: restart `npx expo start` after changing it.
#
# The deployed backend (Render):
#   EXPO_PUBLIC_API_URL=https://<your-service>.onrender.com
# A backend on your PC (`npm run dev` in backend/), phone on the same Wi-Fi:
#   EXPO_PUBLIC_API_URL=http://<your-PC-IPv4-address>:4000   (ipconfig → Wi-Fi IPv4 Address)
#
# Builds set it elsewhere: the APK in eas.json (preview profile), the web app in the
# Vercel project settings (Environment Variables).
EXPO_PUBLIC_API_URL=https://<your-service>.onrender.com
