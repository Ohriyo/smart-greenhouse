# Copy to .env (local development) and fill in. On Render, set the same names in
# the service's Environment tab instead (docs: README "Deploy").
# Never commit .env: it holds secrets.

# development | production (production = JSON logs) | test
NODE_ENV=development

# HTTP + Socket.IO port. Render sets PORT itself.
PORT=4000

# PostgreSQL. Production: the Neon connection string (TLS is enforced for any
# non-local host). Local: e.g. postgresql://postgres:<password>@localhost:5432/greenhouse
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
# Optional: Neon's DIRECT (non-pooled) string, used only by `prisma migrate`.
# Leave unset if DATABASE_URL is already a direct connection.
# DIRECT_URL=

# Shared secret the ESP32 sends as the X-Device-Key header (min 16 characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEVICE_API_KEY=change-me-to-a-long-random-string

# Browser origins allowed to call the API (the Vercel web app), comma-separated,
# no trailing slash. localhost is always allowed for development.
CORS_ORIGIN=https://your-app.vercel.app

# Device used when a reading or query names none (single greenhouse).
DEFAULT_DEVICE_ID=gh-01

# debug | info | warn | error
LOG_LEVEL=info

# Offline detection: 3 missed reading intervals (the device reports `intervalSec`).
# This is the fallback timeout for devices that don't.
OFFLINE_AFTER_SEC=90

# Minimum minutes between two alerts for the same metric (unless severity rises).
ALERT_COOLDOWN_MIN=15

# Raw readings older than this many days are deleted daily (30-day history needs 30).
READINGS_RETENTION_DAYS=30

# Push notifications via Expo Push Service (needs internet). "false" = don't send.
PUSH_ENABLED=true
# Only if you turn on "Enhanced push security" in the Expo project (docs/setup-push.md).
# EXPO_ACCESS_TOKEN=

# SMS alerts to the owner (see docs/setup-sms.md). The owner's number and the on/off
# switch are set in the app (Settings → SMS alerts); only the secrets live here.
#   console   = test mode: messages are written to this backend's log, nothing is sent
#   semaphore = real SMS through semaphore.co (needs SEMAPHORE_API_KEY and credit)
SMS_PROVIDER=console
# SEMAPHORE_API_KEY=
# Registered sender name (max 11 characters); leave out to use your account's default.
# SEMAPHORE_SENDER_NAME=
# Safety limit: alert SMS per rolling 24 hours (test SMS are not counted).
SMS_DAILY_CAP=10

# Dev-only "Presentation tools" in the app (simulate a heat wave / dry soil on the
# simulator). Leave it false except when demonstrating.
DEV_TOOLS=false
