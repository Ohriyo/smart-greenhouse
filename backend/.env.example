# Copy to .env and adjust.

# HTTP + Socket.IO port. Open it in Windows Firewall (see docs/setup-mosquitto.md).
PORT=4000

# Mosquitto runs on this laptop, so the backend can use localhost.
# (The ESP32 and phone use the laptop's LAN IP instead.)
MQTT_URL=mqtt://localhost:1883

# SQLite file, relative to the backend/ folder.
DATABASE_URL=file:./dev.db

# Offline detection: MQTT Last Will, or 3 missed telemetry intervals (the device
# reports `intervalSec`). This is the fallback timeout for devices that don't.
OFFLINE_AFTER_SEC=90

# Minimum minutes between two alerts for the same metric (unless severity rises).
ALERT_COOLDOWN_MIN=15

# Raw readings older than this many days are deleted daily (30-day history needs 30).
READINGS_RETENTION_DAYS=30

# Push notifications via Expo Push Service (needs internet). "false" = don't send.
PUSH_ENABLED=true

# SMS alerts to the owner (see docs/setup-sms.md). The owner's number and the on/off
# switch are set in the app (Settings → SMS alerts); only the secrets live here.
#   console   = test mode: messages are written to this backend's log, nothing is sent
#   semaphore = real SMS through semaphore.co (needs SEMAPHORE_API_KEY and credit)
SMS_PROVIDER=console
# SEMAPHORE_API_KEY=
# Registered sender name (max 11 characters); leave out to use your account's default.
# SEMAPHORE_SENDER_NAME=
# Safety limit: alert SMS per rolling 24 hours (test SMS are not counted).
SMS_DAILY_CAP=10

# Dev-only "Presentation tools" in the app (simulate a heat wave / dry soil on the
# simulator). Leave it false except when demonstrating.
DEV_TOOLS=false

# Only if you turn on "Enhanced push security" in the Expo project (docs/setup-push.md).
# EXPO_ACCESS_TOKEN=
