# Repo-wide ignores. backend/ and mobile/ have their own .gitignore as well.

# Dependencies and build output
node_modules/
dist/

# Secrets / local config (each folder commits a .env.example instead)
.env
.env.*
!.env.example
!.env.test.example

# SQLite databases (backend/dev.db etc.)
*.db
*.db-journal
*.db-wal
*.db-shm

# Firmware: Wi-Fi password, backend URL and device key (secrets.example.h is committed)
firmware/SmartGreenhouse/secrets.h
firmware/.pio/

# Editors / OS / logs
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Local Claude Code project instructions: kept on this machine, not published
CLAUDE.md
